{
  "$schema": "https://ui.buildy.tw/schema.json",
  "contractVersion": "2.0.0",
  "framework": "solid",
  "runtime": "solid",
  "typescript": true,
  "globalCss": "src/index.css",
  "dir": "src",
  "aliases": {
    "@": "./src",
    "@/lib": "./src/lib",
    "@/utils": "./src/utils",
    "@/components": "./src/components",
    "@/ui": "./src/components/ui",
    "@/blocks": "./src/blocks",
    "@/layouts": "./src/layouts",
    "@/variants": "./src/variants",
    "@/widgets": "./src/widgets"
  },
  "registry": "@ui8kit",
  "registryUrl": "https://unpkg.com/@ui8kit/registry@2.0.0/r",
  "strictCdn": true,
  "importStyle": "alias"
}
