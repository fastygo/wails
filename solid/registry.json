{
  "$schema": "https://ui.buildy.tw/schema/registry.json",
  "items": [
    {
      "name": "explorer",
      "type": "registry:widget",
      "runtime": "solid",
      "title": "Explorer",
      "description": "File tree composed from UI8Kit primitives. Fixture nodes until the app passes data.",
      "dependencies": ["solid-js"],
      "registryDependencies": ["block", "box", "button", "icon", "list", "title", "utils"],
      "files": [
        {
          "path": "solid/src/widgets/explorer/Explorer.solid.tsx",
          "target": "widgets/explorer/Explorer.solid.tsx"
        },
        {
          "path": "solid/src/widgets/explorer/fixture.shared.ts",
          "target": "widgets/explorer/fixture.shared.ts"
        }
      ]
    },
    {
      "name": "editor",
      "type": "registry:widget",
      "runtime": "solid",
      "title": "Editor",
      "description": "CodeMirror buffer and tab strip. Fixture text, no host document service.",
      "dependencies": [
        "solid-js",
        "codemirror",
        "@codemirror/lang-go",
        "@codemirror/lang-javascript",
        "@codemirror/lang-markdown",
        "@codemirror/state",
        "@codemirror/theme-one-dark",
        "@codemirror/view"
      ],
      "registryDependencies": ["block", "box", "button", "utils"],
      "files": [
        {
          "path": "solid/src/widgets/editor/Editor.solid.tsx",
          "target": "widgets/editor/Editor.solid.tsx"
        },
        {
          "path": "solid/src/widgets/editor/fixture.shared.ts",
          "target": "widgets/editor/fixture.shared.ts"
        }
      ]
    },
    {
      "name": "terminal",
