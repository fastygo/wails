      "files": [
        {
          "path": "solid/src/widgets/terminal/Terminal.solid.tsx",
          "target": "widgets/terminal/Terminal.solid.tsx"
        },
        {
          "path": "solid/src/widgets/terminal/fixture.shared.ts",
          "target": "widgets/terminal/fixture.shared.ts"
